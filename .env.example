# Dhan broker (only needed for LIVE mode). Never commit real values.
DHAN_CLIENT_ID=your_client_id
DHAN_ACCESS_TOKEN=your_access_token

# Local LLM. Throne falls back to its regex parser if this is unreachable.
OLLAMA_MODEL=tinyllama
OLLAMA_URL=http://localhost:11434

# Frontend -> backend URL (set this in Vercel for deployed builds)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: comma separated origins allowed by the API (default *)
# CORS_ORIGINS=https://your-app.vercel.app
